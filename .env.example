# CampusPulse - College Event Management System Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Dual-Mode Firestore Configuration
# Set to 'true' for zero-friction local in-memory storage (ideal for offline dev, CI, and test runs)
# Set to 'false' to connect to live Google Cloud Firestore & Firebase Auth using Admin SDK
USE_LOCAL_STORE=true

# Firebase Admin SDK Credentials (required only when USE_LOCAL_STORE=false)
FIREBASE_PROJECT_ID=campus-pulse-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@campus-pulse-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://campus-pulse-production.firebaseio.com
FIREBASE_STORAGE_BUCKET=campus-pulse-production.appspot.com

# Client Origin (CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173
