rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Anyone can read published/active events for public portal
      allow read: if resource.data.status in ['PUBLISHED', 'REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'ONGOING', 'COMPLETED']
                  || isAdmin();
      allow write: if isAdmin();
    }
    
    // Programs collection
    match /programs/{programId} {
      allow read: if resource.data.status in ['PUBLISHED', 'REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'ONGOING', 'JUDGING', 'COMPLETED', 'RESULTS_PUBLISHED']
                  || isAdmin();
      allow write: if isAdmin();
    }
    
    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    // Registrations collection
    match /registrations/{registrationId} {
      // Direct writes from public client are disabled; registrations must pass through backend API
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Scores collection
    match /scores/{scoreId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.juryId == request.auth.uid);
      // Only un-locked scores can be updated by the assigned jury member
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.juryId == request.auth.uid);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.juryId == request.auth.uid && 
        resource.data.status != 'LOCKED'
      );
      allow delete: if isAdmin();
    }
    
    // Results collection
    match /results/{resultId} {
      allow read: if resource.data.resultStatus == 'PUBLISHED' || isAdmin();
      allow write: if isAdmin();
    }
    
    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
